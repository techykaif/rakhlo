{
  "name": "rakhlo",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-vercel-env.mjs && npm run prepare:pdf-fonts && next build",
    "start": "next start",
    "typecheck": "npm run prepare:pdf-fonts && tsc --noEmit",
    "test": "npm run prepare:pdf-fonts && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepare:pdf-fonts": "node scripts/prepare-pdf-fonts.mjs",
    "postinstall": "npm run prepare:pdf-fonts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "web-push": "^3.6.7",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@fontsource/noto-sans": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4",
    "@types/web-push": "^3.6.4"
  }
}
