{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rakhlo-notification-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "vars": {
    "RAKHLO_PROCESS_URL": "https://rakhlo.xyz/api/notifications/process"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
